PUBLIC_PORT=8080
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
MINIO_ROOT_USER=tracepilot
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
DEMO_AUTH_ENABLED=true
DEMO_AUTH_USERNAME=replace-with-shared-demo-id
DEMO_AUTH_PASSWORD=replace-with-shared-demo-password
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_COOKIE_SECURE=true
DEMO_COOKIE_SAMESITE=lax
# 동일 사이트 /api reverse proxy에서는 비워 둔다. 교차 사이트 구성에서만 검토 후 지정한다.
# DEMO_COOKIE_DOMAIN=api.example.com
